{
  "name": "pdf-haven",
  "version": "1.1.0",
  "description": "Free offline-first PDF toolkit — merge, split, compress, convert, edit, secure. 100% client-side, no upload, no watermark.",
  "homepage": "https://github.com/Rajath4/pdf-suite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajath4/pdf-suite.git"
  },
  "bugs": {
    "url": "https://github.com/Rajath4/pdf-suite/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-budget.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "budget": "node scripts/check-budget.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "keywords": [
    "pdf",
    "merge",
    "split",
    "compress",
    "offline",
    "privacy"
  ],
  "license": "MIT",
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67",
    "pptxgenjs": "^3.12.0",
    "tesseract.js": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  }
}
